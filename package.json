{
  "name": "omo-account-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAR \u2014 local multi-account hot-switch for OMO/Senpi agents (vault, panel, usage, optional failover)",
  "bin": {
    "oar": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target node --format esm && bun build ./src/daemon-main.ts --outdir dist --target node --format esm --outfile dist/daemon-main.js",
    "test": "bun test",
    "oar": "bun run src/cli.ts",
    "daemon": "bun run src/daemon-main.ts",
    "install:oar": "bash scripts/install.sh",
    "uninstall:oar": "bash scripts/uninstall.sh",
    "smoke": "bun run scripts/smoke-hot-switch.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JIMyungSik/omo-account-router.git"
  },
  "bugs": {
    "url": "https://github.com/JIMyungSik/omo-account-router/issues"
  },
  "homepage": "https://github.com/JIMyungSik/omo-account-router#readme",
  "keywords": [
    "omo",
    "senpi",
    "account",
    "router",
    "oauth",
    "multi-account",
    "grok",
    "codex"
  ]
}
