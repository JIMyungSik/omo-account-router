{
  "name": "@carjms/oar-cli",
  "version": "0.4.0",
  "type": "module",
  "description": "OAR (@carjms/oar-cli) \u2014 local multi-account hot-switch for OMO/Senpi. Command: oar",
  "bin": {
    "oar": "bin/oar.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir dist --target node --format esm --packages=bundle && bun build ./src/daemon-main.ts --outdir dist --target node --format esm --outfile dist/daemon-main.js --packages=bundle && bun build ./extensions/oar-extension-entry.js --outfile dist/oar-extension.js --target node --format esm --packages=bundle && node scripts/fix-shebang.mjs",
    "test": "bun test",
    "typecheck": "bunx tsc --project tsconfig.src.json --noEmit --pretty false",
    "style": "node scripts/check-style.mjs",
    "oar": "bun run src/cli.ts",
    "daemon": "bun run src/daemon-main.ts",
    "install:oar": "bash scripts/install.sh",
    "uninstall:oar": "bash scripts/uninstall.sh",
    "smoke": "bun run scripts/smoke-hot-switch.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JIMyungSik/omo-account-router.git"
  },
  "bugs": {
    "url": "https://github.com/JIMyungSik/omo-account-router/issues"
  },
  "homepage": "https://github.com/JIMyungSik/omo-account-router#readme",
  "keywords": [
    "omo",
    "senpi",
    "account",
    "router",
    "oauth",
    "multi-account",
    "grok",
    "codex"
  ],
  "files": [
    "dist/**/*",
    "bin/**/*",
    "extensions/**/*",
    "scripts/**/*",
    "docs/**/*",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
